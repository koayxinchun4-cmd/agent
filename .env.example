# GEMINI_API_KEY: Required for Gemini AI API calls.
# The secrets Gradle plugin reads this from a local .env file at build time
# and injects it into BuildConfig.
# If the key is left at the placeholder below, Gemini is treated as unavailable.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: Optional OpenRouter API key.
# If the key is left at the placeholder below, OpenRouter is treated as unavailable.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# OPENROUTER_MODEL: Optional model identifier. Defaults to OpenRouter automatic routing.
OPENROUTER_MODEL=openrouter/auto
