# GEMINI_API_KEY: Required for Gemini AI API calls.
# The secrets Gradle plugin reads this from a local .env file at build time
# and injects it into BuildConfig.
# If the key is left as the placeholder below, the app falls back to the
# on-device autonomous engine instead of calling the Gemini API.
GEMINI_API_KEY=MY_GEMINI_API_KEY
