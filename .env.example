# Gemini API key used by the Gemini model provider and existing chat flow.
# The secrets Gradle plugin reads this from a local .env file at build time
# and injects it into BuildConfig.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OpenRouter API key used by the OpenRouter model provider.
# Leave the placeholder when OpenRouter is not configured; Nexus falls back to Local.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
