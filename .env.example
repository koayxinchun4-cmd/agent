# Gemini API key used by the native Gemini ModelProvider.
# Keep the real key in a local .env file; never commit it.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OpenRouter API key used by the OpenRouter ModelProvider.
# Keep the real key in a local .env file; never commit it.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
